# Copy this file to ".env" and add your key.
# This is SECRET. Never commit .env or paste keys into browser code.

# Groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Port for the web app (optional)
PORT=3000

# ElevenLabs — the voice in voice mode (optional; without it the browser's voice is used)
# Get a key at https://elevenlabs.io/app/settings/api-keys  (SECRET)
ELEVENLABS_API_KEY=
# Optional: a different voice (copy the Voice ID from the ElevenLabs voice library)
ELEVENLABS_VOICE_ID=
