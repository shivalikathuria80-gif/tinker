# Copy this file to ".env" and fill in at least one key.
# These are SECRET. Never commit .env or paste keys into browser code.


# OmniRoute — the address of your OmniRoute gateway and its key.
# If you run OmniRoute locally, the default address is usually http://localhost:20128/v1
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Port for the web app (optional)
PORT=3000
